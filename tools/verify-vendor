#!/usr/bin/env python3
"""I verify the immutable vendored librespot source before building."""
import hashlib
from pathlib import Path

root = Path(__file__).resolve().parents[1]
expected = {}
for line in (root / "vendor.sha256").read_text().splitlines():
    digest, name = line.split("  ", 1)
    expected[name] = digest
actual = {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest()
    for path in sorted((root / "vendor").rglob("*")) if path.is_file()}
if actual != expected:
    raise SystemExit("Vendored sources differ from the reviewed revision.")
print(f"Verified {len(actual)} vendored source files.")
